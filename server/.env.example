# Server Configuration
PORT=3001
NODE_ENV=development

# Blockchain Testnet Configuration (Default: Base Sepolia)
CHAIN_ID=84532
NETWORK_NAME=Base Sepolia
RPC_URL=https://sepolia.base.org
BLOCK_EXPLORER_URL=https://sepolia.basescan.org

# Fallback Network (Arbitrum Sepolia)
FALLBACK_CHAIN_ID=421614
FALLBACK_NETWORK_NAME=Arbitrum Sepolia
FALLBACK_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
FALLBACK_BLOCK_EXPLORER_URL=https://sepolia.arbiscan.io

# Dedicated Low-Value Testnet Wallet Private Key (Hex without 0x or with 0x)
# NEVER use a mainnet key or a key holding real assets.
TESTNET_PRIVATE_KEY=0x4c0883a69102937d6231471b5dbb6204fe5129617082792ae468d01a07467193

# Pluggable AI Service Configuration (Optional: uses deterministic fallback if empty)
AI_PROVIDER=deterministic
AI_API_KEY=

# JWT Authentication (Required in production)
JWT_SECRET=your_long_random_jwt_secret_hex_at_least_32_bytes
OPERATOR_EMAIL=operator@nexus.ai
OPERATOR_PASSWORD=your_secure_operator_password_here

# Neon Serverless PostgreSQL Database Connection
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Enterprise Key Management (Optional - defaults to Local Testnet Enclave)
USE_ENTERPRISE_KMS=false
KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/example-key-id
ALLOW_TESTNET_SIGNER_IN_PRODUCTION=false
